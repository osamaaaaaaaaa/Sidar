# Public browser configuration only. Never add Supabase service-role credentials here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_GEMINI_MODEL=gemini-3.5-flash-lite
# Do not set GEMINI_API_KEY in this browser environment file.
# Set it only as a Supabase Edge Function secret: supabase secrets set GEMINI_API_KEY=...
